{
  "name": "plotloop-speaker-review",
  "version": "0.5.0",
  "private": false,
  "description": "A local-first workbench for reviewing speaker labels in meeting transcripts.",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:web && npm run test:automation",
    "test:web": "node --test tests/*.test.mjs",
    "test:automation": "python3 -m unittest discover -s automation/tests -p 'test_*.py'",
    "check:public": "python3 scripts/check_public_repo.py",
    "test:release": "npm test && npm run check:public",
    "serve": "python3 scripts/serve.py"
  },
  "keywords": [
    "speaker-diarization",
    "transcript",
    "meeting",
    "review",
    "local-first"
  ]
}
