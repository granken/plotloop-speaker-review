{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "privacy", "review"],
  "properties": {
    "type": {"type": "string", "const": "speaker-review-analysis"},
    "version": {"type": "integer", "const": 1},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "confidence", "note"],
      "properties": {
        "classification": {"type": "string", "enum": ["work", "private", "uncertain"]},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "note": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "generated_at", "current", "batch"],
      "properties": {
        "type": {"type": "string", "const": "speaker-review"},
        "version": {"type": "integer", "const": 2},
        "generated_at": {"type": "string"},
        "current": {"$ref": "#/definitions/meeting"},
        "batch": {
          "type": "array",
          "items": {"$ref": "#/definitions/meeting"}
        }
      }
    }
  },
  "definitions": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "name", "action", "confidence", "note"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "action": {"type": "string", "enum": ["replace", "keep", "ignore"]},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "note": {"type": "string"}
      }
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting", "date", "time", "file_stem", "note", "mappings"],
      "properties": {
        "meeting": {"type": "string", "minLength": 1},
        "date": {"type": "string"},
        "time": {"type": "string"},
        "file_stem": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/mapping"}
        }
      }
    }
  }
}
